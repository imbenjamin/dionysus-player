<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Export options for `xcodebuild -exportArchive` in .github/workflows/release.yml.

  Hand-written and checked in, unlike Config/Version.xcconfig next to it — this
  one isn't generated by any script.
-->
<plist version="1.0">
<dict>
	<!-- Produces an App Store-signed .ipa for upload to App Store Connect
	     (which is what puts a build in TestFlight). Not `release-testing`
	     or `development` — those sign for direct install and are rejected
	     by the ASC upload. -->
	<key>method</key>
	<string>app-store-connect</string>

	<!-- Manual, and deliberately NOT matching project.yml's
	     CODE_SIGN_STYLE: Automatic. Automatic was tried first and doesn't
	     work here: at export time it asks Apple to create the provisioning
	     profile via cloud signing, which fails with

	         error: exportArchive Cloud signing permission error

	     even with an Admin-level App Store Connect API key (confirmed by a
	     local dry-run, 2026-08-30 — the archive succeeded and only the
	     export failed, because only the export needs the profile). Naming
	     an existing profile sidesteps the cloud-signing path entirely.

	     The archive step still signs automatically; only the export is
	     manual. -->
	<key>signingStyle</key>
	<string>manual</string>

	<!-- Must match the profile's *name* in App Store Connect exactly, not
	     its UUID or filename. release.yml installs it on the runner with
	     apple-actions/download-provisioning-profiles before exporting.
	     If this profile is ever deleted or renamed in the portal, the
	     export fails with "doesn't include signing certificate" or
	     "no profile matching" — recreate it under the same name. -->
	<key>provisioningProfiles</key>
	<dict>
		<key>com.imbenjamin.dionysusplayer</key>
		<string>Dionysus App Store</string>
	</dict>

	<key>teamID</key>
	<string>Z27T535BXZ</string>

	<!-- Send dSYMs to App Store Connect so TestFlight crash reports come
	     back symbolicated. -->
	<key>uploadSymbols</key>
	<true/>

	<!-- LOAD-BEARING. This defaults to *true* for the app-store-connect
	     method, which lets Xcode rewrite CFBundleShortVersionString and
	     CFBundleVersion during export — silently discarding the version
	     Scripts/update-version.sh stamped from the git tag, which is the
	     single source of truth for the entire versioning scheme
	     (see VERSIONING.md). Leave this false. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
